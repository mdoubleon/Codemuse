# CodeMuse local model settings.
# Copy this file to .env and fill in one provider section.
# This CodeMuse-owned .env is ignored by git and loaded automatically by
# scripts/run_agent.py and scripts/run_server.py. A target workspace .env is
# not loaded unless CODEMUSE_TRUST_WORKSPACE_ENV=1 is explicitly set.
# Existing process environment variables win.

# Custom OpenAI-compatible relay or official OpenAI endpoint.
CODEMUSE_API_KEY=your_api_key_here
CODEMUSE_BASE_URL=https://your-relay.example/v1
CODEMUSE_MODEL=your-model
CODEMUSE_PROVIDER=openai_compatible

# Dedicated DeepSeek adapter. To switch, replace CODEMUSE_PROVIDER above with
# CODEMUSE_PROVIDER=deepseek, then set this key.
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional: point the selected model config at a differently named key variable.
# CODEMUSE_API_KEY_ENV=OPENAI_API_KEY
